[Unit]
Description=Review LogFiles HTTPS App
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Review_LogFiles
Environment=APP_HOST=0.0.0.0
Environment=APP_PORT=5001
Environment=FLASK_SECRET_KEY=change-me
ExecStart=/home/ubuntu/Review_LogFiles/.venv/bin/python /home/ubuntu/Review_LogFiles/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
