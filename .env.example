# Copy to .env (the installer does this for you) and adjust as needed.
APP_HOST=0.0.0.0
APP_PORT=5001
# Generated automatically by the installer when missing.
FLASK_SECRET_KEY=change-me-to-a-long-random-value

# Set to 0 to serve plain HTTP (e.g. behind a reverse proxy that terminates TLS).
APP_SSL=1
# Optional: use your own certificate instead of the auto-generated self-signed one.
# SSL_CERT=/etc/ssl/certs/review.pem
# SSL_KEY=/etc/ssl/private/review.key

# Extra directory scanned for *.tgz bundles (uploads/ is always scanned).
# ARCHIVE_DIR=/srv/rdk-logs
MAX_UPLOAD_MB=500
